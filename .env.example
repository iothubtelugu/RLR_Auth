# Robotics Lab of RKV (RLR) — Smart Attendance Management System
# Environment Configuration Template

# Database configuration (SQLite local database file or PostgreSQL URL)
DATABASE_URL="file:./data/rlr_attendance.db"

# JWT Secret for admin/operator session authentication
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# Timezone configuration (Default: Asia/Kolkata)
APP_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Fingerprint Hardware Integration
# Modes: "demo" (simulated biometric adapter) or "hardware" (real local agent bridge)
FINGERPRINT_MODE="demo"
HARDWARE_AGENT_URL="ws://localhost:8080/fingerprint"
HARDWARE_AGENT_HTTP_URL="http://localhost:8080"

# Attendance Business Rules
DUPLICATE_COOLDOWN_SECONDS=15
SESSION_OVERNIGHT_HOURS_LIMIT=12

# Application Port
PORT=3000
